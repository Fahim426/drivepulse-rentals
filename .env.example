# ========================================================
# DrivePulse Car Rental Management System — Environment Config
# ========================================================

# Server & Client Ports
PORT=5000
CLIENT_PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Connection
# SQLite is enabled by default for zero-setup local development
DATABASE_URL="file:./dev.db"
# For PostgreSQL in Production, update provider in schema.prisma and use:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/drivepulse_rentals?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET=drivepulse_jwt_access_secret_super_secure_key_2026_xyz
JWT_REFRESH_SECRET=drivepulse_jwt_refresh_secret_super_secure_key_2026_abc
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# File Storage & Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Security & Account Lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
SESSION_INACTIVITY_MINUTES=30
