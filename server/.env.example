# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (SQLite default for zero-setup local dev)
# For PostgreSQL switch to: postgresql://username:password@localhost:5432/rentals?schema=public
DATABASE_URL="file:./dev.db"

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=drivepulse_jwt_access_secret_super_secure_key_2026_xyz
JWT_REFRESH_SECRET=drivepulse_jwt_refresh_secret_super_secure_key_2026_abc
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
